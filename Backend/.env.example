# Настройки backend. Скопируй этот файл в Backend/.env и впиши свои значения.
# Проверить результат: python Backend/doctor.py
# Сервер читает .env только при старте — после правки перезапусти python Backend/server.py

# Провайдер оценки ответов игрока. Реализован только yandex.
VSM_AI_PROVIDER=yandex

# Ключ сервисного аккаунта Yandex Cloud.
#   Консоль Yandex Cloud -> IAM -> API-ключи -> Создать ключ
#   В поле "Область действия" выбери каталог с доступом к моделям.
VSM_YANDEX_API_KEY=

# ID каталога, в котором открыт доступ к YandexGPT.
#   Консоль Yandex Cloud -> Каталоги -> нужный каталог -> поле ID
VSM_YANDEX_FOLDER_ID=

# URI модели. Скопируй точную строку со страницы модели, например:
#   gpt://<ID-каталога>/yandexgpt/latest
# Доступ к модели нужно один раз открыть в кабинете, иначе будет 403 или 404.
VSM_YANDEX_MODEL_URI=

# Таймаут запроса к модели, секунды. Допустимо 5..90.
VSM_AI_TIMEOUT=45

# Ключ SpeechKit для распознавания голоса. Необязателен: без него игрок отвечает текстом.
#   https://cloud.yandex.ru/services/speechkit
VSM_SPEECHKIT_API_KEY=

# Порт локального сервера. Клиент в Unreal берёт его из Config/DefaultGame.ini (ApiBaseUrlV2).
VSM_PORT=18767

# Адрес прослушивания. 127.0.0.1 — только этот компьютер.
# Поставь 0.0.0.0, только если проверяешь сборку на телефоне: телефон не достучится
# до 127.0.0.1, потому что там этот адрес указывает на сам телефон.
VSM_BIND=127.0.0.1

# Пароль демо-пользователя. Значение из примера — заглушка, придумай своё.

# Путь к базе смен относительно корня репозитория.

# Раскомментируй, если хочешь видеть трейсбек необработанных исключений в логе сервера.
# В трейсбеке может мелькнуть ключ, поэтому по умолчанию выключено.
# VSM_LOG_TRACEBACK=1
