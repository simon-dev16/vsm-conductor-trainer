# Copy this file to Backend/.env. It is loaded by the ASGI v2 backend.
# Keep real credentials only in Backend/.env; that file is ignored by Git.
VSM_AI_PROVIDER=yandex
VSM_YANDEX_API_KEY=
VSM_YANDEX_FOLDER_ID=
VSM_YANDEX_MODEL_URI=
VSM_AI_TIMEOUT=45

# Optional SpeechKit transcription. Leave blank for text-only input.
VSM_SPEECHKIT_API_KEY=

# Compose supplies VSM_SHIFT_DATABASE from the PostgreSQL password in root .env.
# When running ASGI directly, it defaults to Backend/data/shifts.sqlite3.
# VSM_SHIFT_DATABASE=

# Legacy server.py / diagnostics only; not the ASGI v2 database setting.
VSM_PORT=18767
# VSM_DATABASE=Backend/data/vsm.sqlite3
